// EduGear — multi-tenant school management SaaS
// PRIMARY RULE: every school-owned table carries `schoolId`. Tenant filtering is
// enforced at runtime by the Prisma tenant-guard extension (src/database/tenant-guard.extension.ts).
// The column layout below is deliberately RLS-ready: a future `USING (school_id = current_setting(...))`
// policy can be layered on without a schema change.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: DATABASE_URL is the pooled connection, DIRECT_URL the direct one used by migrations.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  UNCLE
  AUNT
  OTHER
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

/// The tenant. Everything school-owned hangs off this row.
model School {
  id          String       @id @default(uuid()) @db.Uuid
  /// Public, human-friendly tenant handle (used in URLs/subdomains later).
  slug        String       @unique
  name        String
  shortName   String?
  email       String
  phone       String?
  addressLine String?
  city        String?
  state       String?
  country     String       @default("NG")
  logoUrl     String?
  motto       String?
  status      SchoolStatus @default(PENDING)
  timezone    String       @default("Africa/Lagos")
  currency    String       @default("NGN")
  /// Soft-delete marker; tenant data is never hard-deleted on cancellation.
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  roles                Role[]
  memberships          Membership[]
  academicSessions     AcademicSession[]
  terms                Term[]
  classes              Class[]
  classArms            ClassArm[]
  students             Student[]
  guardians            Guardian[]
  studentGuardians     StudentGuardian[]
  auditLogs            AuditLog[]
  feeCategories        FeeCategory[]
  feeStructures        FeeStructure[]
  feeStructureItems    FeeStructureItem[]
  studentFees          StudentFee[]
  studentFeeItems      StudentFeeItem[]
  payments             Payment[]
  feeReminders         FeeReminder[]
  subjects             Subject[]
  classSubjects        ClassSubject[]
  teachingAssignments  TeachingAssignment[]
  assessmentComponents AssessmentComponent[]
  gradeBands           GradeBand[]
  scores               Score[]
  resultSheets         ResultSheet[]
  studentResults       StudentResult[]
  subjectResults       SubjectResult[]
  attendanceRecords    AttendanceRecord[]
  notifications        Notification[]
  settings             SchoolSettings?

  @@index([status])
  @@map("schools")
}

// ---------------------------------------------------------------------------
// Identity, access control
// ---------------------------------------------------------------------------

/// Global identity. A user is NOT owned by a school — school access is granted
/// through Membership, so one person can belong to several schools.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  /// Bumped on password change / logout-all to invalidate outstanding tokens.
  tokenVersion        Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  memberships        Membership[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  invitesSent        Membership[]        @relation("MembershipInvitedBy")
  auditLogs          AuditLog[]
  guardianProfiles   Guardian[]
  notifications      Notification[]

  @@index([status])
  @@map("users")
}

/// A role is school-owned: the six system roles are copied into every school at
/// provisioning, which lets a school customise permissions later (Phase 5)
/// without touching other tenants.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  slug        String
  description String?
  /// System roles cannot be deleted or renamed.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@map("roles")
}

/// Global catalogue of permission keys, e.g. `students.read`. Seeded, not tenant-owned.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  group       String
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Links a user to a school with exactly one role. This is the tenant membership
/// record — the server derives the active tenant from it, never from the client.
model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  schoolId    String           @db.Uuid
  roleId      String           @db.Uuid
  status      MembershipStatus @default(INVITED)
  /// School-issued staff number, unique per school when present.
  staffId     String?
  /// The membership a multi-school user lands on at login.
  isDefault   Boolean          @default(false)
  invitedById String?          @db.Uuid
  invitedAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role      Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User?          @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  sessions  RefreshToken[]
  auditLogs AuditLog[]

  @@unique([userId, schoolId])
  @@unique([schoolId, staffId])
  @@index([schoolId, status])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

/// Hashed refresh tokens (no Redis in the MVP stack). Rotation + reuse detection
/// works off `familyId`: replaying a revoked token kills the whole family.
model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  membershipId      String?   @db.Uuid
  /// SHA-256 of the opaque token; the raw value is never stored.
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid
  createdByIp       String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use, hashed tokens for email verification, password reset and invitations.
model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  consumedAt DateTime?
  metadata   Json?
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Academic structure (schema only in Phase 0 — modules land in Phase 1)
// ---------------------------------------------------------------------------

model AcademicSession {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  /// e.g. "2025/2026"
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms         Term[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

model Term {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  sessionId String   @db.Uuid
  name      TermName
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session       AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  scores        Score[]
  resultSheets  ResultSheet[]

  @@unique([sessionId, name])
  @@index([schoolId, isCurrent])
  @@map("terms")
}

/// A class level, e.g. JSS 1. `level` drives promotion ordering.
model Class {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  arms          ClassArm[]
  feeStructures FeeStructure[]
  classSubjects ClassSubject[]

  @@unique([schoolId, name])
  @@unique([schoolId, level])
  @@index([schoolId])
  @@map("classes")
}

/// A stream within a class, e.g. JSS 1 A.
model ClassArm {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  classId       String   @db.Uuid
  name          String
  capacity      Int?
  /// Form teacher, referenced by membership so the link breaks if staff leave.
  formTeacherId String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class               Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  students            Student[]
  teachingAssignments TeachingAssignment[]
  scores              Score[]
  resultSheets        ResultSheet[]
  attendance          AttendanceRecord[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("class_arms")
}

// ---------------------------------------------------------------------------
// Students and guardians (schema only in Phase 0 — modules land in Phase 1)
// ---------------------------------------------------------------------------

model Student {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @db.Uuid
  /// Admission number — unique per school, NOT globally.
  studentId     String
  firstName     String
  lastName      String
  middleName    String?
  gender        Gender
  dateOfBirth   DateTime?     @db.Date
  email         String?
  phone         String?
  addressLine   String?
  photoUrl      String?
  admissionDate DateTime      @db.Date
  status        StudentStatus @default(ACTIVE)
  classArmId    String?       @db.Uuid
  bloodGroup    String?
  genotype      String?
  stateOfOrigin String?
  lga           String?
  nationality   String        @default("Nigerian")
  religion      String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classArm       ClassArm?          @relation(fields: [classArmId], references: [id], onDelete: SetNull)
  guardians      StudentGuardian[]
  fees           StudentFee[]
  payments       Payment[]
  reminders      FeeReminder[]
  scores         Score[]
  studentResults StudentResult[]
  subjectResults SubjectResult[]
  attendance     AttendanceRecord[]

  @@unique([schoolId, studentId])
  @@index([schoolId, status])
  @@index([schoolId, classArmId])
  @@index([schoolId, lastName, firstName])
  @@map("students")
}

model Guardian {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  firstName   String
  lastName    String
  email       String?
  phone       String
  altPhone    String?
  addressLine String?
  occupation  String?
  /// Set once the guardian claims a parent-portal login (Phase 4).
  userId      String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students  StudentGuardian[]
  reminders FeeReminder[]

  // NULL emails stay non-conflicting in Postgres, so guardians without email are fine.
  @@unique([schoolId, email])
  @@index([schoolId, phone])
  @@index([schoolId, lastName])
  @@map("guardians")
}

model StudentGuardian {
  studentId    String               @db.Uuid
  guardianId   String               @db.Uuid
  /// Denormalised so the tenant guard can scope the join table directly.
  schoolId     String               @db.Uuid
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  canPickUp    Boolean              @default(true)
  createdAt    DateTime             @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([schoolId])
  @@index([guardianId])
  @@map("student_guardians")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// `schoolId` is nullable because some security events (failed login for an
/// unknown email) happen before a tenant is resolved. Reads are always scoped.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @db.Uuid
  actorUserId  String?  @db.Uuid
  membershipId String?  @db.Uuid
  action       String
  entityType   String?
  entityId     String?
  description  String?
  /// Never store secrets, tokens or password material here.
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime @default(now())

  school     School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@index([schoolId, action])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Finance (Phase 2)
//
// Money is Decimal(12,2), never a float: naira amounts must add up exactly.
// An invoice (StudentFee) snapshots what it charged, so editing or renaming a
// fee structure later cannot rewrite what a parent was already billed.
// ---------------------------------------------------------------------------

enum FeeStructureStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudentFeeStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  ONLINE
  CHEQUE
}

/// Recorded money is PENDING until a bursar verifies it; only VERIFIED payments
/// reduce a balance, which is what makes an unverified receipt harmless.
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// A kind of charge — Tuition, Books, PTA levy.
model FeeCategory {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  FeeStructureItem[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("fee_categories")
}

/// What a given class owes for a session or term.
model FeeStructure {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @db.Uuid
  sessionId   String             @db.Uuid
  /// Null means the charge covers the whole session rather than one term.
  termId      String?            @db.Uuid
  /// Null means it applies to every class in the school.
  classId     String?            @db.Uuid
  name        String
  description String?
  status      FeeStructureStatus @default(DRAFT)
  dueDate     DateTime?          @db.Date
  /// Maintained from the items so listing does not have to aggregate.
  totalAmount Decimal            @default(0) @db.Decimal(12, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session     AcademicSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term        Term?              @relation(fields: [termId], references: [id], onDelete: Cascade)
  class       Class?             @relation(fields: [classId], references: [id], onDelete: Cascade)
  items       FeeStructureItem[]
  studentFees StudentFee[]

  @@unique([schoolId, sessionId, name])
  @@index([schoolId, status])
  @@index([schoolId, sessionId, termId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  structureId String   @db.Uuid
  categoryId  String   @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  /// Optional charges (a school bus place) are billed only when asked for.
  isOptional  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  category  FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([structureId, categoryId])
  @@index([schoolId])
  @@map("fee_structure_items")
}

/// One student's invoice for one fee structure.
model StudentFee {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  structureId    String           @db.Uuid
  sessionId      String           @db.Uuid
  termId         String?          @db.Uuid
  /// Snapshot of the structure total at assignment.
  totalAmount    Decimal          @db.Decimal(12, 2)
  /// Scholarships and sibling discounts reduce what is owed without hiding it.
  discountAmount Decimal          @default(0) @db.Decimal(12, 2)
  /// Maintained from VERIFIED payments only.
  amountPaid     Decimal          @default(0) @db.Decimal(12, 2)
  status         StudentFeeStatus @default(UNPAID)
  dueDate        DateTime?        @db.Date
  waiverReason   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  structure FeeStructure     @relation(fields: [structureId], references: [id], onDelete: Restrict)
  items     StudentFeeItem[]
  payments  Payment[]

  @@unique([studentId, structureId])
  @@index([schoolId, status])
  @@index([schoolId, studentId])
  @@index([schoolId, sessionId, termId])
  @@map("student_fees")
}

/// What the invoice charged, copied at assignment. Category name is denormalised
/// so renaming or deleting a category never rewrites an issued bill.
model StudentFeeItem {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  studentFeeId String   @db.Uuid
  categoryId   String?  @db.Uuid
  categoryName String
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentFeeId])
  @@map("student_fee_items")
}

model Payment {
  id                     String        @id @default(uuid()) @db.Uuid
  schoolId               String        @db.Uuid
  studentFeeId           String        @db.Uuid
  studentId              String        @db.Uuid
  /// Issued on verification, unique per school.
  receiptNumber          String
  amount                 Decimal       @db.Decimal(12, 2)
  method                 PaymentMethod
  /// Teller number, transfer reference or POS stub.
  reference              String?
  evidenceUrl            String?
  paidAt                 DateTime
  status                 PaymentStatus @default(PENDING)
  note                   String?
  /// Memberships, not users: staff leaving must not orphan a payment record.
  recordedByMembershipId String?       @db.Uuid
  verifiedByMembershipId String?       @db.Uuid
  verifiedAt             DateTime?
  rejectionReason        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, status])
  @@index([schoolId, studentId])
  @@index([schoolId, paidAt])
  @@index([studentFeeId])
  @@map("payments")
}

enum ReminderStatus {
  SENT
  FAILED
}

/// One fee reminder about one student to one guardian address. The log is what
/// enforces the cooldown — so a second click does not mail every parent again —
/// and what answers "when did we last chase this family?".
model FeeReminder {
  id                 String         @id @default(uuid()) @db.Uuid
  schoolId           String         @db.Uuid
  /// Groups everything sent by one request.
  batchId            String         @db.Uuid
  studentId          String         @db.Uuid
  guardianId         String?        @db.Uuid
  email              String
  amountOwed         Decimal        @db.Decimal(12, 2)
  status             ReminderStatus
  sentByMembershipId String?        @db.Uuid
  createdAt          DateTime       @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, batchId])
  @@index([schoolId, createdAt])
  @@map("fee_reminders")
}

// ---------------------------------------------------------------------------
// Results (Phase 3)
//
// Scores are the raw input; StudentResult and SubjectResult are what a result
// sheet computes from them. Computing happens while the sheet is DRAFT; once
// SUBMITTED the snapshot and the scores behind it are frozen, so what a
// principal approves is exactly what parents are later shown.
// ---------------------------------------------------------------------------

enum ResultSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  /// Short code printed on report cards, e.g. "MTH".
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects       ClassSubject[]
  teachingAssignments TeachingAssignment[]
  scores              Score[]
  subjectResults      SubjectResult[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, isActive])
  @@map("subjects")
}

/// Which subjects a class offers.
model ClassSubject {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  classId      String   @db.Uuid
  subjectId    String   @db.Uuid
  /// Electives count only for students with scores in them.
  isCompulsory Boolean  @default(true)
  createdAt    DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@map("class_subjects")
}

/// Who teaches a subject to an arm — and therefore who may enter its scores.
model TeachingAssignment {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @db.Uuid
  classArmId          String   @db.Uuid
  subjectId           String   @db.Uuid
  /// A membership id with no foreign key, like ClassArm.formTeacherId, so staff
  /// leaving does not take the assignment history with them.
  teacherMembershipId String   @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classArmId, subjectId])
  @@index([schoolId, teacherMembershipId])
  @@map("teaching_assignments")
}

/// One part of a subject's mark, e.g. "1st CA" out of 10 or "Exam" out of 70.
model AssessmentComponent {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  maxScore  Int
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("assessment_components")
}

model GradeBand {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  grade     String
  minScore  Int
  maxScore  Int
  remark    String
  isPass    Boolean
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, grade])
  @@index([schoolId])
  @@map("grade_bands")
}

model Score {
  id                    String   @id @default(uuid()) @db.Uuid
  schoolId              String   @db.Uuid
  studentId             String   @db.Uuid
  subjectId             String   @db.Uuid
  termId                String   @db.Uuid
  componentId           String   @db.Uuid
  /// The arm the student was in when scored — they may be promoted later.
  classArmId            String   @db.Uuid
  score                 Decimal  @db.Decimal(5, 2)
  enteredByMembershipId String?  @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  term      Term                @relation(fields: [termId], references: [id], onDelete: Restrict)
  component AssessmentComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  classArm  ClassArm            @relation(fields: [classArmId], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId, termId, componentId])
  @@index([schoolId, classArmId, subjectId, termId])
  @@map("scores")
}

/// A class arm's results for a term, and where they are in the approval flow.
model ResultSheet {
  id                      String            @id @default(uuid()) @db.Uuid
  schoolId                String            @db.Uuid
  classArmId              String            @db.Uuid
  termId                  String            @db.Uuid
  status                  ResultSheetStatus @default(DRAFT)
  computedAt              DateTime?
  /// Set on every score save; later than computedAt means the snapshot is stale.
  scoresChangedAt         DateTime?
  submittedAt             DateTime?
  submittedByMembershipId String?           @db.Uuid
  approvedAt              DateTime?
  approvedByMembershipId  String?           @db.Uuid
  publishedAt             DateTime?
  publishedByMembershipId String?           @db.Uuid
  /// Why it was last sent back to DRAFT.
  returnedReason          String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classArm       ClassArm        @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  term           Term            @relation(fields: [termId], references: [id], onDelete: Restrict)
  studentResults StudentResult[]
  subjectResults SubjectResult[]

  @@unique([classArmId, termId])
  @@index([schoolId, status])
  @@index([schoolId, termId])
  @@map("result_sheets")
}

model StudentResult {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @db.Uuid
  resultSheetId      String   @db.Uuid
  studentId          String   @db.Uuid
  totalScore         Decimal  @db.Decimal(7, 2)
  averageScore       Decimal  @db.Decimal(5, 2)
  /// Null for a student taking no subjects.
  position           Int?
  subjectCount       Int
  formTeacherComment String?
  principalComment   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resultSheet ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([resultSheetId, studentId])
  @@index([schoolId, studentId])
  @@map("student_results")
}

/// One subject line on a report card, with the class figures printed beside it.
model SubjectResult {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  resultSheetId   String   @db.Uuid
  studentId       String   @db.Uuid
  subjectId       String   @db.Uuid
  /// Copied, so renaming a subject never rewrites a published report card.
  subjectName     String
  totalScore      Decimal  @db.Decimal(5, 2)
  grade           String?
  remark          String?
  isPass          Boolean
  position        Int
  /// [{ name, maxScore, score }] as computed, in scheme order.
  componentScores Json
  classHighest    Decimal  @db.Decimal(5, 2)
  classLowest     Decimal  @db.Decimal(5, 2)
  classAverage    Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resultSheet ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([resultSheetId, studentId, subjectId])
  @@index([schoolId, studentId])
  @@map("subject_results")
}

// ---------------------------------------------------------------------------
// Attendance and notifications (Phase 4)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One student's mark on one school day.
model AttendanceRecord {
  id                     String           @id @default(uuid()) @db.Uuid
  schoolId               String           @db.Uuid
  studentId              String           @db.Uuid
  /// The arm whose register it was taken in.
  classArmId             String           @db.Uuid
  date                   DateTime         @db.Date
  status                 AttendanceStatus
  note                   String?
  recordedByMembershipId String?          @db.Uuid
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Restrict)

  @@unique([studentId, date])
  @@index([schoolId, classArmId, date])
  @@map("attendance_records")
}

enum NotificationType {
  RESULT_PUBLISHED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  FEE_REMINDER
  INVOICE_ISSUED
}

/// An in-app message for one user in one school — the parent portal's inbox.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Ids the client needs to link through, e.g. { studentId, termId }.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, readAt])
  @@index([schoolId, userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// School settings (Phase 5)
// ---------------------------------------------------------------------------

/// Operational settings a school controls for itself. One row per school,
/// created on first change — an absent row means "all defaults".
model SchoolSettings {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @unique @db.Uuid

  /// Prefixes admission numbers: "BSC" gives BSC/2025/0001. Null gives 2025/0001.
  admissionNumberPrefix String?
  /// Prefixes receipts, e.g. RCP/2025/000001.
  receiptPrefix         String  @default("RCP")

  /// Turns the parent portal off school-wide without revoking any login.
  portalEnabled        Boolean @default(true)
  /// Days before the same family can be reminded about fees again.
  reminderCooldownDays Int     @default(7)
  /// Default days to pay when a fee structure sets no due date.
  invoiceDueDays       Int?

  /// Some schools deliberately do not rank children.
  reportShowPosition   Boolean @default(true)
  /// Class highest, lowest and average beside each subject.
  reportShowClassStats Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}
