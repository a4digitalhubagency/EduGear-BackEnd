# ---------------------------------------------------------------------------
# EduGear backend — copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=EduGear
# Public URL of this API (used in emails)
APP_URL=http://localhost:3000
# Public URL of the frontend (used to build verification / reset links)
FRONTEND_URL=http://localhost:5173
# Comma-separated origins, or * in development only
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# Database (Neon in production)
# DATABASE_URL is the POOLED connection string used by the app.
DATABASE_URL=postgresql://edugear:edugear@localhost:55432/edugear?schema=public
# DIRECT_URL is the DIRECT (non-pooled) connection used by prisma migrate.
# On Neon these differ; locally they are the same.
DIRECT_URL=postgresql://edugear:edugear@localhost:55432/edugear?schema=public
# Used only by integration tests — must point at a throwaway database.
TEST_DATABASE_URL=postgresql://edugear:edugear@localhost:55432/edugear_test?schema=public

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=edugear
JWT_AUDIENCE=edugear-api

# Auth policy
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=168

# Rate limiting (shared across instances when REDIS_URL is set)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10
# Account creation / email-sending endpoints (per hour)
STRICT_THROTTLE_TTL_SECONDS=3600
STRICT_THROTTLE_LIMIT=5

# Email (Resend)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="EduGear <no-reply@example.com>"

# Paystack — online card payments. Online payment is simply off until the
# secret key is set; nothing else changes. Use the test key (sk_test_...) in
# development, and set the webhook URL in the Paystack dashboard to
# <APP_URL>/api/webhooks/paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Where uploads go when R2 is not configured. Development and tests only.
STORAGE_LOCAL_DIR=storage

# File storage (Cloudflare R2, S3-compatible). Without it, uploads go to
# STORAGE_LOCAL_DIR — which production refuses, so set these before deploying.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Redis — backs rate limiting and the permission cache across instances.
# Optional locally (the app falls back to per-instance state); REQUIRED in production.
# docker compose up -d starts one on port 56379.
REDIS_URL=redis://localhost:56379
REDIS_KEY_PREFIX=edugear:
